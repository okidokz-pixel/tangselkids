# Copy this to .env.local for local development and fill in real values.
# Never commit real secrets — this file only holds placeholders.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_HOOK_SECRET=your-supabase-webhook-secret

# Google Analytics (GA4) — used by src/lib/ga-data.ts
GA_CLIENT_EMAIL=ga-service-account@your-project.iam.gserviceaccount.com
GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GA_PROPERTY_ID=your-ga4-property-id

# Internal monitoring bot — GET /api/internal/daily-stats
# Any long random string; the bot must send it back as the `x-internal-key` header.
# Route returns 401 for every request until this is set.
INTERNAL_REPORT_KEY=replace-with-a-long-random-string

# Search Console
GSC_SITE_URL=https://tangselkids.com

# Google Maps / geocoding
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# OTP providers
FAZPASS_API_KEY=your-fazpass-api-key
FAZPASS_GATEWAY_KEY=your-fazpass-gateway-key
OTPSPACE_API_KEY=your-otpspace-api-key

# Alert emails (Resend)
RESEND_API_KEY=your-resend-api-key
ALERT_EMAIL_FROM=alerts@tangselkids.com
ALERT_EMAIL_TO=you@example.com

# Admin access
ADMIN_EMAILS=you@example.com

# Vercel Cron auth for /api/monitor/* routes
CRON_SECRET=replace-with-a-long-random-string

# Claude/Anthropic (if used by any tooling)
ANTHROPIC_API_KEY=your-anthropic-api-key
